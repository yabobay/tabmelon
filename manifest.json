{
  "manifest_version": 2,
  "name": "Tab Lemon",
  "version": "0.0",

  "description": "Tells you how many tabs are open!",

  "icons": {
    "48": "icons/lemon48.png",
    "96": "icons/lemon96.png"
  },

  "browser_action": {
    "default_popup": "lemon.html"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "tablemon@yabobay.codeberg.org"
    }
  }
}
